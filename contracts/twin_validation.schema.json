{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurax.local/contracts/twin_validation.schema.json",
  "title": "Digital twin validation contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["meta", "mape", "pass"],
  "properties": {"meta": {"$ref": "#/$defs/meta"}, "mape": {"type": "number"}, "pass": {"type": "boolean"}},
  "$defs": {"meta": {"type": "object", "additionalProperties": true, "required": ["generated_at", "source", "assumption_ids", "tag"], "properties": {"generated_at": {"type": "string"}, "source": {"type": "string"}, "assumption_ids": {"type": "array", "items": {"type": "string"}}, "tag": {"type": "string"}}}}
}
