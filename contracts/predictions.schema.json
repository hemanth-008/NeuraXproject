{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurax.local/contracts/predictions.schema.json",
  "title": "Per-unit predictions parquet contract",
  "type": "object",
  "additionalProperties": true,
  "x-artifact-type": "parquet",
  "x-columns": {
    "unit_id": {"required": true, "dtype": "string"},
    "image_path": {"required": true, "dtype": "string"},
    "batch_id": {"required": true, "dtype": "object"},
    "variant": {"required": true, "dtype": "object"},
    "condition": {"required": true, "dtype": "object"},
    "station": {"required": true, "dtype": "object"},
    "ts": {"required": true, "dtype": "object"},
    "p_defect": {"required": true, "dtype": "number"},
    "class_probs": {"required": true, "dtype": "string"},
    "pred_family": {"required": true, "dtype": "string"},
    "decision": {"required": true, "dtype": "string"},
    "flag": {"required": true, "dtype": "string"},
    "conformal_set": {"required": true, "dtype": "string"},
    "anomaly_score": {"required": true, "dtype": "object"},
    "heatmap_path": {"required": true, "dtype": "object"},
    "boxes_mask_ref": {"required": true, "dtype": "object"},
    "localization_basis": {"required": true, "dtype": "object"},
    "true_label": {"required": true, "dtype": "string"},
    "source_split": {"required": true, "dtype": "string"},
    "box_xyxy": {"required": false, "dtype": "object"},
    "novel_score": {"required": false, "dtype": "number"},
    "top2": {"required": false, "dtype": "object"},
    "tile_boxes": {"required": false, "dtype": "object"},
    "mixed_defect_flag": {"required": false, "dtype": "boolean"},
    "ensemble_agreement": {"required": false, "dtype": "number"}
  }
}
