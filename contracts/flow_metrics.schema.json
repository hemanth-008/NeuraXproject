{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurax.local/contracts/flow_metrics.schema.json",
  "title": "Flow metrics contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["meta", "stations", "bottleneck", "evidence", "loss_waterfall"],
  "properties": {"meta": {"$ref": "#/$defs/meta"}, "stations": {"type": "array"}, "bottleneck": {"type": "object"}, "evidence": {"type": "array"}, "loss_waterfall": {"type": "array"}},
  "$defs": {"meta": {"type": "object", "additionalProperties": true, "required": ["generated_at", "source", "assumption_ids", "tag"], "properties": {"generated_at": {"type": "string"}, "source": {"type": "string"}, "assumption_ids": {"type": "array", "items": {"type": "string"}}, "tag": {"type": "string"}}}}
}
