{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurax.local/contracts/localization.schema.json",
  "title": "Localization evidence contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["meta", "n", "method", "caveats"],
  "properties": {"meta": {"$ref": "#/$defs/meta"}, "n": {"type": "integer"}, "method": {"type": "string"}, "caveats": {"type": "array"}},
  "$defs": {"meta": {"type": "object", "additionalProperties": true, "required": ["generated_at", "source", "assumption_ids", "tag"], "properties": {"generated_at": {"type": "string"}, "source": {"type": "string"}, "assumption_ids": {"type": "array", "items": {"type": "string"}}, "tag": {"type": "string"}}}}
}
